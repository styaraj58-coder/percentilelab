# See DEPLOYMENT.md for how to get these from Supabase (pooler host, both
# Transaction-mode/6543 and Session-mode/5432 — not the direct connection,
# which is IPv6-only).
DATABASE_URL="postgresql://postgres.<ref>:<password>@<pooler-host>:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<ref>:<password>@<pooler-host>:5432/postgres"

# Auth.js - generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Seed admin account (used once by `npm run db:seed`)
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME=""

# New-student notification email (sent via Resend on every registration)
# Get a key at https://resend.com/api-keys — leave blank to skip sending.
RESEND_API_KEY=""
ADMIN_NOTIFICATION_EMAIL=""
