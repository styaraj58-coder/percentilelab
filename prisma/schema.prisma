// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Role is a plain string ("ADMIN" | "STUDENT") instead of a native enum so the
// schema ports cleanly to Postgres later without touching this file.

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  passwordHash String
  role         String        @default("STUDENT")
  // Student profile fields — required at signup for STUDENT accounts
  // (enforced in app validation), left null for seeded ADMIN accounts.
  phone        String?
  college      String?
  course       String?
  targetExam   String?
  createdAt    DateTime      @default(now())
  testsCreated Test[]        @relation("TestCreatedBy")
  attempts     TestAttempt[]
  resourcesCreated Resource[] @relation("ResourceCreatedBy")
  passwordResetTokens PasswordResetToken[]
  bankQuestionsCreated BankQuestion[] @relation("BankQuestionCreatedBy")
}

// Forgot-password flow: a short-lived, single-use token emailed to the
// user. Only the SHA-256 hash is stored — the raw token (in the emailed
// link) is never persisted, so a DB leak alone can't be used to reset
// anyone's password.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Test {
  id              String        @id @default(cuid())
  title           String
  description     String?
  // Which MBA entrance exam this test is modeled on — see MBA_ENTRANCE_EXAMS
  // in src/lib/validation.ts for the allowed values (same list students pick
  // from at registration).
  targetExam      String        @default("MH-CET (MBA)")
  durationMinutes Int
  published       Boolean       @default(false)
  createdById     String
  createdBy       User          @relation("TestCreatedBy", fields: [createdById], references: [id])
  sections        Section[]
  attempts        TestAttempt[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([targetExam])
}

model Section {
  id        String     @id @default(cuid())
  testId    String
  test      Test       @relation(fields: [testId], references: [id], onDelete: Cascade)
  name      String
  order     Int
  questions Question[]
  passages  Passage[]
}

// A passage (or shared instructions/data) that several consecutive questions
// in a section refer back to — e.g. a reading passage with 5 sub-questions,
// or a cloze paragraph with one blank per question.
model Passage {
  id        String     @id @default(cuid())
  sectionId String
  section   Section    @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  title     String?
  text      String
  questions Question[]
}

model Question {
  id          String   @id @default(cuid())
  sectionId   String
  section     Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  passageId   String?
  passage     Passage? @relation(fields: [passageId], references: [id], onDelete: SetNull)
  order       Int
  text        String
  imageUrl    String?
  explanation String?
  marks       Int      @default(1)
  // Carried over from BankQuestion when a test is generated from the bank;
  // left null for hand-built tests. Powers the results page's "Weak Topics"
  // breakdown — that section is skipped entirely when a test has no topic
  // data at all.
  topic       String?
  subTopic    String?
  options     Option[]
  answers     Answer[]
}

model Option {
  id         String     @id @default(cuid())
  questionId String
  question   Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  imageUrl   String?
  isCorrect  Boolean    @default(false)
  order      Int
  answers    Answer[]   @relation("SelectedOption")
}

model TestAttempt {
  id          String    @id @default(cuid())
  testId      String
  test        Test      @relation(fields: [testId], references: [id], onDelete: Cascade)
  studentId   String
  student     User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  startedAt   DateTime  @default(now())
  submittedAt DateTime?
  score       Int?
  totalMarks  Int?
  answers     Answer[]

  @@index([testId])
  @@index([studentId])
}

// Admin-uploaded study resources shown on the public Resources page —
// either a video link or a downloadable PDF.
model Resource {
  id          String   @id @default(cuid())
  type        String   // "VIDEO" | "PDF"
  title       String
  description String?
  url         String
  createdById String
  createdBy   User     @relation("ResourceCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([type])
}

// A shared stimulus multiple bank questions are grouped under — a seating/
// arrangement puzzle's scenario, a DI dataset, a reading passage, etc. Mirrors
// Passage's role on a materialized Test, but at the bank level, and generation
// pulls every question in a set together (never a partial set) since they only
// make sense read against the same stimulus.
model BankQuestionSet {
  id        String         @id @default(cuid())
  title     String?
  stimulus  String
  imageUrl  String?
  questions BankQuestion[]
  createdAt DateTime       @default(now())
}

// A pool question, independent of any specific Test. The mock generator draws
// from here (filtered by section/difficulty, excluding already-used
// questions) and materializes real Test/Section/Passage/Question/Option rows
// from what it picks — generated tests behave exactly like hand-built ones
// afterward, so nothing about the exam-taking, grading, or results code needs
// to know a test was ever bank-generated.
model BankQuestion {
  id                   String              @id @default(cuid())
  // Top-level mock section this question belongs to — kept as a plain string
  // (not a relation) so it lines up with Section.name on generated tests
  // without a join. See BANK_SECTIONS in src/lib/validation.ts.
  section              String
  topic                String
  subTopic             String?
  difficulty           String
  estimatedTimeSeconds Int                 @default(60)
  conceptTested        String?
  tags                 String[]            @default([])
  order                Int                 @default(0)
  setId                String?
  set                  BankQuestionSet?    @relation(fields: [setId], references: [id], onDelete: SetNull)
  text                 String
  imageUrl             String?
  explanation          String?
  marks                Int                 @default(1)
  options              BankOption[]
  // Once drawn into a generated mock, a bank question is retired (never
  // reused across mocks) — set the first time it's consumed.
  usedInTestId         String?
  createdById          String
  createdBy            User                @relation("BankQuestionCreatedBy", fields: [createdById], references: [id])
  createdAt            DateTime            @default(now())

  @@index([section, topic, difficulty])
  @@index([usedInTestId])
}

model BankOption {
  id             String       @id @default(cuid())
  bankQuestionId String
  bankQuestion   BankQuestion @relation(fields: [bankQuestionId], references: [id], onDelete: Cascade)
  text           String
  imageUrl       String?
  isCorrect      Boolean      @default(false)
  order          Int
}

model Answer {
  id               String      @id @default(cuid())
  attemptId        String
  attempt          TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId       String
  question         Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOptionId String?
  selectedOption   Option?     @relation("SelectedOption", fields: [selectedOptionId], references: [id])
  timeSpentSeconds Int         @default(0)

  @@unique([attemptId, questionId])
}
