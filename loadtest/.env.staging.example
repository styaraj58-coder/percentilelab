# Copy this file to  loadtest/.env.staging  and fill in your STAGING database.
# It must be a SEPARATE Supabase project - never the production one.
# (The seed script refuses to run if it detects the production project.)
#
# Same two strings the app uses - see DEPLOYMENT.md, section 1:
#   DATABASE_URL = Transaction pooler, port 6543, ends with ?pgbouncer=true
#   DIRECT_URL   = Session pooler,     port 5432
DATABASE_URL="postgresql://postgres.<STAGING-ref>:<password>@aws-<n>-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<STAGING-ref>:<password>@aws-<n>-<region>.pooler.supabase.com:5432/postgres"
